# LLM provider
LLM_API_KEY=your_api_key
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL_NAME=gpt-4o-mini
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1500

# Input/output paths
CV_FOLDER=CV
JD_PATH=jd.txt
RULE_TXT_PATH=rule.txt

# OCR: tesseract | qwen | pix2struct
OCR_ENGINE=tesseract
QWEN_MODEL_NAME=Qwen/Qwen2-VL-7B-Instruct

# Embedding: hybrid-bge | bge | nomic
EMBEDDING_ENGINE=hybrid-bge
EMBEDDING_BASE_MODEL=BAAI/bge-m3
EMBEDDING_LORA_PATH=model/bge

# Pipeline controls
TOP_K_RAG=5
MAX_RULES=0
MUST_HAVE_KEYWORDS=Python,Postgres
MUST_NOT_HAVE_KEYWORDS=PHP,WordPress
